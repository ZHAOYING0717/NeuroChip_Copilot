.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.streamlit/secrets.toml

# Public datasets are downloaded from the declared sources.
data/raw/
data/interim/
data/processed/*.parquet
data/processed/*.csv

# Reproducible generated outputs.
artifacts/*.log
artifacts/models/
artifacts/reports/
artifacts/figures/
docs/assets/*.tiff
docs/archive/

# Local delivery builds and visual QA files.
output/video/
output/submission/
tmp/

# Heavy local tooling (GIN CLI distribution, 500+ MB) — not part of the source.
tools/

# Intermediate analysis products (public demo assets live in data/demo).
data/processed/
data/x/

# Entrant-local runtime state: uploads, project database, QA screenshots, logs.
artifacts/uploads/
artifacts/projects/
artifacts/qa/
artifacts/logs/

# Python packaging metadata generated at install time.
*.egg-info/

# Submission build manifest (regenerated by scripts/build_submission_package.py).
REPOSITORY_MANIFEST.json

*.zip
*.raw.h5

# Debug logs
output/*.log
